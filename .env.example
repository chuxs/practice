# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/js-node-practice?appName=Cluster0

# Anthropic (required for question generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model
# ANTHROPIC_MODEL=claude-sonnet-5
